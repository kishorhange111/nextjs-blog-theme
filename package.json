{
  "name": "nextjs-blog-theme",
  "description": "A customizable Next.js and Tailwind blog starter. Designed by the Bejamas agency.",
  "author": "Bejamas and Netlify Inc.",
  "contributors": [
    "Charlie Gerard",
    "Prince Wilson",
    "Tara Manicsic",
    "Thom Krupa"
  ],
  "homepage": "https://github.com/netlify-templates/nextjs-blog-theme",
  "bugs": {
    "url": "https://github.com/netlify-templates/nextjs-blog-theme/issues"
  },
  "scripts": {
    "dev": "next",
    "dev:watch": "next-remote-watch ./posts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "classnames": "^2.3.1",
    "cypress": "^16.2.1",
    "gray-matter": "^4.0.2",
    "next": "^15.5.29",
    "next-mdx-remote": "^6.0.0",
    "next-remote-watch": "1.0.0",
    "prismjs": "^1.30.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rehype-prism-plus": "^2.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "eslint": "<9.0.0",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^8.3.0",
    "netlify-plugin-cypress": "~2.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.0.0"
  },
  "overrides": {
    "prismjs": "$prismjs",
    "postcss": "$postcss"
  }
}
